generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model answer_options {
  answer_id        String           @db.Uuid
  option_id        String           @db.Uuid
  answers          answers          @relation(fields: [answer_id], references: [id], onDelete: Cascade, map: "fk_answer_options_answers")
  question_options question_options @relation(fields: [option_id], references: [id], map: "fk_answer_options_options")

  @@id([answer_id, option_id], map: "pk_answer_options")
}

model answers {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  response_id    String           @db.Uuid
  question_id    String           @db.Uuid
  answer_text    String?
  answer_number  Decimal?         @db.Decimal(12, 2)
  answer_options answer_options[]
  questions      questions        @relation(fields: [question_id], references: [id], map: "fk_answers_questions")
  responses      responses        @relation(fields: [response_id], references: [id], onDelete: Cascade, map: "fk_answers_responses")

  @@unique([response_id, question_id], map: "uq_answers_response_question")
  @@index([question_id], map: "idx_answers_question_id")
}

model assessment_categories {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(150)
  description String?
  created_at  DateTime      @default(now()) @db.Timestamp(6)
  assessments assessments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assessments {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id           String                @db.Uuid
  created_by            String                @db.Uuid
  title                 String                @db.VarChar(255)
  description           String?
  target_group          target_group
  public_token          String?               @unique @db.VarChar(100)
  start_at              DateTime?             @db.Timestamp(6)
  end_at                DateTime?             @db.Timestamp(6)
  status                assessment_status     @default(DRAFT)
  created_at            DateTime              @default(now()) @db.Timestamp(6)
  updated_at            DateTime              @default(now()) @db.Timestamp(6)
  assessment_categories assessment_categories @relation(fields: [category_id], references: [id], map: "fk_assessments_categories")
  users                 users                 @relation(fields: [created_by], references: [id], map: "fk_assessments_users")
  questions             questions[]
  responses             responses[]

  @@index([category_id], map: "idx_assessments_category_id")
  @@index([created_by], map: "idx_assessments_created_by")
  @@index([status], map: "idx_assessments_status")
}

model question_options {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id    String           @db.Uuid
  option_text    String           @db.VarChar(255)
  score          Int              @default(0)
  sort_order     Int              @default(0)
  answer_options answer_options[]
  questions      questions        @relation(fields: [question_id], references: [id], onDelete: Cascade, map: "fk_options_questions")

  @@index([question_id], map: "idx_question_options_question_id")
}

model questions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id    String             @db.Uuid
  question_text    String
  question_type    question_type
  is_required      Boolean            @default(false)
  sort_order       Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  answers          answers[]
  question_options question_options[]
  assessments      assessments        @relation(fields: [assessment_id], references: [id], onDelete: Cascade, map: "fk_questions_assessments")

  @@index([assessment_id], map: "idx_questions_assessment_id")
}

model responses {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id    String          @db.Uuid
  respondent_type  respondent_type
  respondent_name  String?         @db.VarChar(150)
  respondent_email String?         @db.VarChar(150)
  submitted_at     DateTime        @default(now()) @db.Timestamp(6)
  answers          answers[]
  assessments      assessments     @relation(fields: [assessment_id], references: [id], onDelete: Cascade, map: "fk_responses_assessments")

  @@index([assessment_id], map: "idx_responses_assessment_id")
  @@index([submitted_at], map: "idx_responses_submitted_at")
}

model roles {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        role_name @unique
  description String?   @db.VarChar(255)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  users       users[]
}

model users {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String        @db.Uuid
  full_name     String        @db.VarChar(150)
  email         String        @unique @db.VarChar(150)
  password_hash String        @db.VarChar(255)
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  updated_at    DateTime      @default(now()) @db.Timestamp(6)
  assessments   assessments[]
  roles         roles         @relation(fields: [role_id], references: [id], map: "fk_users_roles")

  @@index([role_id], map: "idx_users_role_id")
}

enum assessment_status {
  DRAFT
  PUBLISHED
  CLOSED
}

enum question_type {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  NUMBER
}

enum respondent_type {
  INTERNAL
  EXTERNAL
}

enum role_name {
  ADMIN
  STAFF
}

enum target_group {
  INTERNAL
  EXTERNAL
  BOTH
}
